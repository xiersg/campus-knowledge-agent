[Unit]
Description=校园知识咨询
After=network.target

[Service]
Type=simple
User=campusagent
Group=campusagent
WorkingDirectory=/opt/campus-knowledge-agent
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 -m campus_agent --host 0.0.0.0 --port 443
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
